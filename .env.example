# Copy to .env.local — never commit real keys.
# Same Supabase project as Work Assistants (MissionBoard-iOS / Android).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Google OAuth is configured in Supabase Auth → Providers → Google
# (same Client ID/Secret as mobile). App redirect: {origin}/auth/callback
# Also allow that callback (and Vercel preview URLs) under Supabase
# Authentication → URL configuration.
